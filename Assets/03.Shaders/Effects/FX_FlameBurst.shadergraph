    "m_FunctionBody": "float2 uv = UV;\r\nuv.x *= 6.0;\nuv.y += -0.05;\r\n\r\nfloat id    = floor(uv.x);            // ★ 빠진 줄: 타일 번호\r\nfloat local = frac(uv.x);             // ★ 빠진 줄: 타일 안쪽 0~1\r\n\r\nfloat h1 = frac((id + Seed) * 0.1031);\r\nh1 *= h1 + 33.33;  h1 *= h1 + h1;  h1 = frac(h1);\r\n\r\nfloat h2 = frac((id + Seed + 7.0) * 0.1031);\r\nh2 *= h2 + 33.33;  h2 *= h2 + h2;  h2 = frac(h2);\r\n\r\n// --- 최대값 안에서 랜덤 (-Max ~ +Max) ---\r\nfloat tilt   = (h1 * 2.0 - 1.0) * TiltMax;      // 기울기\r\nfloat height = (h2 * 2.0 - 1.0) * HeightMax;    // 높이 이동\r\n\r\n// 적용\r\nlocal += tilt * uv.y;                 // 기울기 (반경 비례 shear)\r\nuv.x = id + local;\r\nuv.y += height;                       // 높이 이동\r\nuv.y += Progress;                     // 스크롤\r\n\r\nOutUV = uv;"
}

