{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "256fe28f3375463aaa0a0400e1efd2c1",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SetColor (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 533.0,
            "y": 195.9999542236328,
            "width": 204.0,
            "height": 125.00001525878906
        }
    },
    "m_Slots": [
        {
            "m_Id": "f930caf1f02f4bd1807944d75986bd82"
        },
        {
            "m_Id": "4e14c7e1de5043baa088e7db9c4cf884"
        },
        {
            "m_Id": "754fb3da9f544b19bc1e414d23d572e2"
        },
        {
            "m_Id": "e21add983632403b9d107194d16940d5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SetColor",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 명도 기반 무채색 (그냥 회색 아니라 색의 밝기를 유지한 회색)\r\nfloat gray = dot(Color, float3(0.299, 0.587, 0.114));\r\n\r\n// Progress가 GrayStart 넘으면 회색으로 전환\r\nfloat t = smoothstep(GrayStart, GrayStart + 0.2, Progress);   // 0.3~0.5 사이 부드럽게\r\nOut = lerp(Color, gray.xxx, t);"
}

